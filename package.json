{
  "name": "obsidian-hotkeys-for-templates",
  "version": "1.4.5",
  "description": "Add hotkeys to insert specific templates",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs dev",
    "build": "pnpm run tsc && node esbuild.config.mjs production",
    "tsc": "tsc --noEmit",
    "release": "commit-and-tag-version"
  },
  "keywords": [],
  "author": "Vinzent03",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "commit-and-tag-version": "^13.3.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@popperjs/core": "2.11.8"
  },
  "commit-and-tag-version": {
    "t": "",
    "bumpFiles": [
      "package.json",
      "manifest.json"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@12.9.0"
}
