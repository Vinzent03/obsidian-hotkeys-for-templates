{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2021",
    "strict": false,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [],
